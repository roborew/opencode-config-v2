{
  "$schema": "https://opencode.ai/config.json",
  // opencode-config-v2 — Robin's user-level OpenCode 2.x configuration.
  // The repo IS the config directory: on the Mac it is cloned to ~/.config/opencode,
  // on the server the opencode-server image clones it at CONFIG_REF.
  //
  // Two primary modes override OpenCode's built-in agents by ID (D22):
  //   plan  = Define + Plan   (Kimi K3.1 Pro, Go)
  //   build = Build → Verify → Review → Ship (DeepSeek V4.1 Flash, Go)
  // Models come from OpenCode Zen (opencode) and OpenCode Go (opencode-go) only (D7, D27).
  "model": "opencode-go/deepseek-v4.1-flash",
  "default_agent": "build",
  // Provider lock (D27): deny every provider, then allow Zen and Go.
  // Force-push and push-to-main are hard-denied here as well as in the agent
  // permissions — no session can override these.
  "policies": [
    {
      "action": "provider.use",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "provider.use",
      "resource": "opencode",
      "effect": "allow"
    },
    {
      "action": "provider.use",
      "resource": "opencode-go",
      "effect": "allow"
    },
    {
      "action": "tool.use",
      "resource": "shell:git push --force*",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:git push * main",
      "effect": "deny"
    }
  ],
  // No `skills` array on purpose (ADR 0009): skills/addy/* and skills/oc/* are found
  // by auto-discovery of this config directory's `skills/` folder. Relative `skills`
  // entries resolve from the working directory (not this file), and globs are not
  // supported — nested component skills are added by the oc-skills prompt hook instead.
  "worktree": {
    "directory": "~/.opencode-worktrees"
  },
  // MCP servers. mcpjungle is the gateway to Robin's MCP sources (remote,
  // bearer-token auth — the token lives in the environment, never in this
  // public repo). browse is OpenCode's browsing companion on the Mac; the
  // opencode-server overrides disable or repoint it where the binary differs.
  "mcp": {
    "servers": {
      "mcpjungle": {
        "type": "remote",
        "url": "https://mcpjungle.roborew.xyz/mcp",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:MCPJUNGLE_TOKEN}"
        }
      },
      "browse": {
        "type": "local",
        "command": [
          "/Users/robo/.local/bin/browse",
          "mcp"
        ],
        "cwd": "~",
        "pool": true,
        "environment": {
          "OPENCODE_BROWSER_RUNTIME": "auto-update"
        }
      }
    }
  },
  "agents": {
    "plan": {
      "model": "opencode-go/kimi-k3.1-pro",
      "system": "You are the Plan gateway to the two-mode delivery flow (Define → Plan). Follow the attached using-agent-skills and oc-plan-gateway skills as mandatory workflows; using-agent-skills also discovers every applicable Addy skill as context changes.\n\nA new initiative without an approved spec starts Define automatically, even when the request arrives through /plan or by merely selecting Plan. Never ask Robin to invoke /spec separately. An approved spec or PRD resumes at vertical-slice planning. Read the app repo's AGENTS.md front matter and delegate read-only research to explore/general.\n\nYou are not unconditionally read-only. You must write specs to docs/spec/<slug>.md before requesting spec approval, and may write decisions under docs/decisions/**; you never write app code or tasks/plan.md/tasks/todo.md. After spec approval, you own the spec branch and PR plus the PRD through oc-github. After separate slice-breakdown approval, you create all linked slice issues. Never switch to Build or claim a file-writing limitation to avoid these handoffs; request shell approval when needed.\n\nThe two human gates are mandatory: written spec approval, then numbered slice-breakdown approval before issues are created. Hedged answers are not approval. Only after both and completed issue creation does Build take over.",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "edit",
          "resource": "docs/spec/**",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "docs/decisions/**",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "gh issue *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "gh api *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git status*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git log*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git diff*",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "skill",
          "resource": "interview-me",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "idea-refine",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "spec-driven-development",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "constraint-driven-development",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "api-and-interface-design",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "source-driven-development",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "planning-and-task-breakdown",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "documentation-and-adrs",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "using-agent-skills",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "oc-plan-gateway",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "oc-github",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "explore",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "general",
          "effect": "allow"
        }
      ]
    },
    "build": {
      "model": "opencode-go/deepseek-v4.1-flash",
      "system": "You are the Build gateway to the delivery flow (Build → Verify → Review → Ship). Follow the attached using-agent-skills and oc-build-gateway skills as mandatory workflows, invoking every applicable Addy skill as context changes. No manually named skill or phase command is needed to discover conditional work such as source verification, doubt review, observability, performance, security, constraints or launch readiness. Specs and slices come from plan; never invent requirements. If a slice is ambiguous or won't converge after three focused attempts, call slice_block with a short actionable reason and go idle.\n\nIn the main checkout you are the user's persistent build coordinator; never implement there. Reconcile before dispatch: when the user says a PR merged, verify it, call slice_finish, confirm the linked slice issue is closed, close every affected PRD whose last slice is merged, then call slice_start for newly unblocked slices (up to the slot limit), excluding every issue with an active slice record, and report slice_status. Call slice_sync on every /build run to retry pending syncs. If slice_finish refuses cleanup, preserve and report the dirty worktree and retained slot. When the user references a PR, resolve it to its linked active slice issue before calling slice_message; use slice_resume for a BLOCKED slice after its blocker is resolved. Never create a replacement session or PR. Surface READY, BLOCKED and MERGED notifications concisely. READY means the user reviews and tests; agents never merge.\n\nIn a slice worktree, work the slice in vertical order through only the layers that exist and are touched: for example migration (expand) → API → regenerate any declared client through its generator service (commit it; never hand-edit it) → web → E2E. Skip absent layers; do not invent a backend or client generator for a self-contained full-stack app. For each acceptance criterion follow the RED/GREEN loop: write the failing test, commit it test-only, run it through sandbox_test (it must fail — RED), then write the minimum code, commit, and re-run (it must pass — GREEN). Every test run goes through the oc-sandbox tools in the isolated Docker setup — never on the host, never through raw docker or just.\n\nNever edit, weaken, delete or skip a test to make it pass. Never hand-edit declared generated code. Never print .env values.\n\nWhen the slice is green: run the code-reviewer subagent (and security-auditor when the slice has risk:security or touches auth, secrets, migrations, dependency manifests or infra), fix or answer every finding, run sandbox_gate and redgreen_check, push, open the PR through oc-github, and hand over to oc-pr-monitor. The user merges; you never merge.",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "git add*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git commit*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git status*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git diff*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git log*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git fetch*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git push -u origin slice/*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "gh pr *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "gh issue comment*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "gh issue list*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "gh issue view*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "gh issue edit*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "gh issue close*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "docker*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "sandbox*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "just import-env*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "just deploy*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "deploy*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git push --force*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git push * main*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git reset --hard*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "rm -rf /*",
          "effect": "deny"
        },
        {
          "action": "skill",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "skill",
          "resource": "using-agent-skills",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "oc-build-gateway",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "incremental-implementation",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "test-driven-development",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "context-engineering",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "source-driven-development",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "doubt-driven-development",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "frontend-ui-engineering",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "api-and-interface-design",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "browser-testing-with-devtools",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "debugging-and-error-recovery",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "code-review-and-quality",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "code-simplification",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "security-and-hardening",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "performance-optimization",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "git-workflow-and-versioning",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "ci-cd-and-automation",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "deprecation-and-migration",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "documentation-and-adrs",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "observability-and-instrumentation",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "constraint-driven-development",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "shipping-and-launch",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "oc-worktree",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "oc-sandbox",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "oc-github",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "oc-pr-monitor",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "code-reviewer",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "security-auditor",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "explore",
          "effect": "allow"
        }
      ]
    },
    "explore": {
      "model": "opencode-go/glm-5.3-flash"
    },
    "general": {
      "model": "opencode-go/glm-5.3-flash"
    },
    "title": {
      "model": "opencode-go/gpt-6-luna"
    }
  },
  "plugins": [
    {
      "package": "./plugins/oc-skills"
    },
    {
      "package": "./plugins/oc-sandbox",
      "options": {
        "backend": "{env:OC_SANDBOX_BACKEND}",
        "sidecarUrl": "{env:OC_SANDBOX_URL}",
        "sidecarToken": "{env:OC_SANDBOX_TOKEN}"
      }
    },
    {
      "package": "./plugins/oc-worktree",
      "options": {
        "maxParallel": 3,
        "worktreeRoot": "~/.opencode-worktrees"
      }
    },
    {
      "package": "./plugins/oc-pr-monitor",
      "options": {
        "intervalMs": 120000,
        "maxRounds": 5
      }
    }
  ]
}
